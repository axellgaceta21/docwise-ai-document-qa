# Copy this file to backend/.env and provide your Groq API key.
GROQ_API_KEY=your-example-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
# Set a long random value for production; never commit the real value.
DOCWISE_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Comma-separated exact browser origins. Production must not use a wildcard.
DOCWISE_ENV=development
DOCWISE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Supabase Session Pooler URI (port 5432). URL-encode special password characters.
# Keep this backend-only; use a separate test database for automated integration tests.
DATABASE_URL=postgresql://postgres.example:replace-me@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
# Optional for tests only: a separate disposable Supabase project or local _test database.
# Tests reject the production Supabase project and truncate Docwise tables in the test target.
# TEST_DATABASE_URL=postgresql://postgres.test-project-ref:replace-me@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
# Anonymous record retention, inbound API body limit (both uploads plus form data),
# request-rate limits, and daily comparison/Groq quotas.
DOCWISE_RETENTION_DAYS=30
DOCWISE_MAX_REQUEST_BYTES=23068672
DOCWISE_RATE_LIMIT_PER_MINUTE=120
DOCWISE_IP_RATE_LIMIT_PER_MINUTE=300
DOCWISE_DAILY_COMPARISONS_PER_VISITOR=10
DOCWISE_DAILY_COMPARISONS_PER_IP=30
DOCWISE_DAILY_GROQ_PER_VISITOR=3
DOCWISE_DAILY_GROQ_PER_IP=10

# Optional verified prices in USD per million tokens. Leave unset to hide cost.
# GROQ_INPUT_USD_PER_MILLION_TOKENS=
# GROQ_OUTPUT_USD_PER_MILLION_TOKENS=
